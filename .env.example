# PicX API — the /v1 suffix is MANDATORY; the bare host 404s
PICX_API_BASE=https://api.picxstudio.com/v1

# Shared across EVERY replica, >=32 bytes. Without this, an interactive round
# resumed on a different replica fails validation.
REQUEST_STATE_KEY=

# Valkey/Redis — required for tasks, response cache, OAuth client storage
REDIS_URL=redis://localhost:6379

# OAuth (Phase 5). Explicit signing key, or tokens die when the client secret rotates.
JWT_SIGNING_KEY=
STORAGE_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PICX_MCP_BASE_URL=https://mcp.picxstudio.com

# Safety
SESSION_CREDIT_CEILING=2000
CONFIRM_CREDIT_THRESHOLD=200
